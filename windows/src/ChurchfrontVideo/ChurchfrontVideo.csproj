<Project Sdk="Microsoft.NET.Sdk">
  <!-- ChurchfrontVideo.exe: the booth app. WPF, written in code (no XAML). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ChurchfrontVideo</AssemblyName>
    <RootNamespace>CueVideo.App</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <StartupObject>CueVideo.App.Program</StartupObject>
    <!-- WPF text layout needs real cultures. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CueVideo.Core\CueVideo.Core.csproj" />
    <Resource Include="AppIcon.ico" />
    <!-- Auto tracking: runs the body-pose model on the graphics chip (DirectML), or the processor. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <!-- When this build was made (UTC), shown on Engineer → Status with the version and commit. -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>
</Project>
