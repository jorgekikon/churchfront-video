<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pretend hardware for testing with nothing plugged in: an ATEM switcher (UDP 9910),
       three VISCA over IP cameras (UDP 52381-52383) and a Canon camera (HTTP, 127.0.0.1:8091).
       A C# port of Tools/fake_atem.py, so no Python is needed on Windows.
       Usage: dotnet run, then the port and the words cams and canon with two dashes each. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The NDI runtime loader, for the fake NDI sources. -->
    <ProjectReference Include="..\..\src\CueVideo.Core\CueVideo.Core.csproj" />
  </ItemGroup>
</Project>
